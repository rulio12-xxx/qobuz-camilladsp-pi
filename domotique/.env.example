# Copier en .env (non versionne) et adapter.

# Reseau a scanner (detection Shelly / Reolink). Vide = auto (sous-reseau du serveur).
SCAN_SUBNET=
SCAN_INTERVAL=300

# MQTT (broker Mosquitto du docker-compose)
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USER=domotique
MQTT_PASSWORD=change-moi
MQTT_BASE=domotique

# Scan Bluetooth (BLE) : 1 pour activer
BLE_SCAN=1

# Interface web
WEB_PORT=8100
FRIGATE_URL=http://localhost:5000

# Reolink : un seul compte pour les 3 cameras (cree un utilisateur dedie
# "frigate" dans chaque camera, droits lecture seule suffisants)
FRIGATE_RTSP_USER=frigate
FRIGATE_RTSP_PASSWORD=change-moi
CAM1_IP=192.168.1.51
CAM2_IP=192.168.1.52
CAM3_IP=192.168.1.53

# Disque reseau (monte sur le serveur, voir README)
NAS_RECORDINGS=/mnt/nas/frigate
